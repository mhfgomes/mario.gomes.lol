---
import Icon from './Icon.astro';

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
---

<div data-share class="relative inline-flex items-center">
  <button
    data-share-btn
    type="button"
    aria-label="Share this profile"
    data-url={url}
    data-title={title}
    class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800/80 dark:hover:bg-zinc-700/80 text-zinc-600 dark:text-zinc-300 border border-zinc-200/80 dark:border-zinc-700/60 shadow-xs transition-all duration-200 hover:scale-105 active:scale-95 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-600 dark:focus-visible:ring-indigo-400 focus-visible:ring-offset-2 focus-visible:ring-offset-[#fafafa] dark:focus-visible:ring-offset-[#0c0c0e] cursor-pointer"
    title="Share or copy profile link"
  >
    <!-- Default Share Icon -->
    <span data-share-icon-default class="transition-transform duration-200">
      <Icon name="share-2" class="w-4 h-4" />
    </span>

    <!-- Success Check Icon -->
    <span data-share-icon-success class="hidden text-emerald-500 dark:text-emerald-400 transition-transform duration-200 scale-110">
      <Icon name="check" class="w-4 h-4" />
    </span>

    <!-- Error Icon -->
    <span data-share-icon-error class="hidden text-red-500 dark:text-red-400 transition-transform duration-200 scale-110">
      <Icon name="circle-alert" class="w-4 h-4" />
    </span>
  </button>

  <!-- Clean dropdown feedback bubble below the button -->
  <div
    data-share-toast
    role="status"
    aria-live="polite"
    aria-hidden="true"
    class="absolute right-0 top-full mt-2 pointer-events-none opacity-0 translate-y-1 transition-all duration-200 z-50 flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 shadow-xl text-xs font-medium whitespace-nowrap border border-zinc-800 dark:border-zinc-200"
  >
    <span data-share-toast-icon-success class="hidden">
      <Icon name="check" class="w-3.5 h-3.5 text-emerald-400 dark:text-emerald-600 shrink-0" />
    </span>
    <span data-share-toast-icon-error class="hidden">
      <Icon name="circle-alert" class="w-3.5 h-3.5 text-red-400 dark:text-red-600 shrink-0" />
    </span>
    <span data-share-toast-text></span>
  </div>
</div>

<script>
  const setupShare = (root: HTMLElement) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-share-btn]');
    const toast = root.querySelector<HTMLElement>('[data-share-toast]');
    const toastText = root.querySelector<HTMLElement>('[data-share-toast-text]');
    const iconDefault = root.querySelector<HTMLElement>('[data-share-icon-default]');
    const iconSuccess = root.querySelector<HTMLElement>('[data-share-icon-success]');
    const iconError = root.querySelector<HTMLElement>('[data-share-icon-error]');
    const toastIconSuccess = root.querySelector<HTMLElement>('[data-share-toast-icon-success]');
    const toastIconError = root.querySelector<HTMLElement>('[data-share-toast-icon-error]');
    if (!btn || root.dataset.bound) return;
    root.dataset.bound = 'true';

    const successRing = ['ring-2', 'ring-emerald-500/50'];
    const errorRing = ['ring-2', 'ring-red-500/50'];
    let resetTimer: ReturnType<typeof setTimeout> | undefined;
    let announceTimer: ReturnType<typeof setTimeout> | undefined;

    const reset = () => {
      if (toast) {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'translate-y-1');
        toast.setAttribute('aria-hidden', 'true');
      }
      if (toastText) toastText.textContent = '';
      iconDefault?.classList.remove('hidden');
      iconSuccess?.classList.add('hidden');
      iconError?.classList.add('hidden');
      btn.classList.remove(...successRing, ...errorRing);
    };

    const showFeedback = (kind: 'success' | 'error', message: string) => {
      clearTimeout(resetTimer);
      clearTimeout(announceTimer);
      reset();

      const isError = kind === 'error';
      toastIconSuccess?.classList.toggle('hidden', isError);
      toastIconError?.classList.toggle('hidden', !isError);
      iconDefault?.classList.add('hidden');
      (isError ? iconError : iconSuccess)?.classList.remove('hidden');
      btn.classList.add(...(isError ? errorRing : successRing));

      if (toast) {
        toast.removeAttribute('aria-hidden');
        toast.classList.remove('opacity-0', 'translate-y-1');
        toast.classList.add('opacity-100', 'translate-y-0');
      }

      // Set the text after clearing it so repeat messages are re-announced
      announceTimer = setTimeout(() => {
        if (toastText) toastText.textContent = message;
      }, 50);

      resetTimer = setTimeout(reset, 2000);
    };

    btn.addEventListener('click', async () => {
      const shareUrl = btn.dataset.url || window.location.href;
      const shareTitle = btn.dataset.title || document.title;

      if (navigator.share) {
        try {
          await navigator.share({
            title: shareTitle,
            url: shareUrl,
          });
          return;
        } catch (err) {
          if (err instanceof Error && err.name === 'AbortError') {
            return;
          }
          // Fall through to clipboard if share failed
        }
      }

      // Clipboard fallback
      try {
        await navigator.clipboard.writeText(shareUrl);
        showFeedback('success', 'Link copied!');
      } catch (e) {
        showFeedback('error', 'Failed to copy');
      }
    });
  };

  const setupShares = () => {
    document.querySelectorAll<HTMLElement>('[data-share]').forEach(setupShare);
  };

  setupShares();
  document.addEventListener('astro:page-load', setupShares);
</script>
